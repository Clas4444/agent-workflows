{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loop repository manifest contract v1",
  "description": "Contract version is independent of the catalog release version. Additional metadata is allowed for backwards compatibility.",
  "type": "object",
  "required": ["version", "skills", "project_skill_roots"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "project_skill_roots": {
      "const": [".github/skills", ".agents/skills", ".claude/skills"]
    }
  },
  "additionalProperties": true
}
